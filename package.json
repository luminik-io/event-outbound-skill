{
  "name": "event-outbound-skill",
  "version": "0.3.0",
  "description": "Cross-client skill for generating validated event-driven outbound sequences.",
  "main": "dist/index.js",
  "type": "module",
  "files": [
    ".claude-plugin/",
    ".codex-plugin/",
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "data/",
    "dist/",
    "examples/",
    "marketplace/",
    "scripts/",
    "skills/"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest",
    "lint": "eslint . --ext .ts",
    "scan": "tsx scripts/scan-deliverables.ts",
    "validate:sequence": "node scripts/validate-sequence.mjs",
    "validate:artifact": "node scripts/validate-artifact.mjs",
    "check:showcase": "node scripts/check-claude-showcase.mjs",
    "check:clients": "node scripts/check-client-packaging.mjs",
    "e2e:claude": "node scripts/run-claude-showcase.mjs",
    "e2e:claude:matrix": "node scripts/run-claude-matrix.mjs",
    "e2e:claude:full": "node scripts/run-claude-full-sequence.mjs",
    "test:matrix-runner": "node scripts/run-claude-matrix.mjs --self-test",
    "test:full-runner": "node scripts/run-claude-full-sequence.mjs --self-test",
    "test:dependency-compat": "node scripts/check-dependency-compat.mjs",
    "verify": "npm run build && npm run test -- --run && npm run test:dependency-compat && npm run test:matrix-runner && npm run test:full-runner && npm run scan && npm run check:showcase && npm run check:clients"
  },
  "keywords": [],
  "author": "Luminik (DataRavel Inc.)",
  "license": "MIT",
  "devDependencies": {
    "@types/jsdom": "^28.0.1",
    "@types/node": "^20.11.5",
    "@typescript-eslint/eslint-plugin": "^6.19.1",
    "@typescript-eslint/parser": "^6.19.1",
    "eslint": "^8.56.0",
    "prettier": "^3.2.4",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.3.3",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "cheerio": "^1.0.0-rc.12",
    "jsdom": "^24.0.0"
  },
  "overrides": {
    "vite": "^6.4.2",
    "esbuild": "^0.25.0",
    "minimatch": "^10.2.6",
    "js-yaml": "^4.3.1",
    "brace-expansion": "^5.0.9",
    "nanoid": "^3.3.17",
    "undici": "^7.29.0"
  }
}
